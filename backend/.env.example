# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://localhost:5432/bank_ledger_db

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
# Replace with a randomly generated secret of at least 32 bytes.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_bytes

# Frontend origin (required in production)
FRONTEND_URL=http://localhost:5173
